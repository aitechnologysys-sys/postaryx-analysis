# Copy to .env only if you use a process manager that loads it.
# The server reads plain environment variables.

# Port the internal tool listens on
PORT=4000

# Where the HTML reports live (absolute path, or relative to the project root).
# Leave unset to use ./reports
# REPORTS_DIR=/srv/postaryx/reports

# Where the SQLite catalogue is kept. Leave unset to use ./data/library.db
# DB_PATH=/var/lib/postaryx/library.db

# Where deleted reports are moved. Leave unset to use ./data/trash
# TRASH_DIR=/var/lib/postaryx/trash

# How long (ms) before the next request re-scans the folder.
SCAN_CACHE_MS=2000
